# 后端环境变量示例（复制为 .env 或在启动时通过环境变量传入）

# 应用连接的 PostgreSQL（开发库）
DATABASE_URL=postgres://ledger:ledger@127.0.0.1:5433/ledger

# 测试连接的 PostgreSQL（独立测试库，会被重建）
TEST_DATABASE_URL=postgres://ledger:ledger@127.0.0.1:5433/ledger_test

# 服务端口
PORT=3001

# —— 公网部署必配的安全项 ——
# JWT 签名密钥：务必改成一段足够长的随机字符串（如 openssl rand -hex 32）
JWT_SECRET=please-change-to-a-long-random-secret

# 允许的前端来源（CORS），多个用逗号分隔；不设则允许所有来源（仅适合本机/内网）
# 例：ALLOWED_ORIGIN=https://ledger.example.com
ALLOWED_ORIGIN=

# 生产环境标记（启用后会对默认密钥发出告警）
# NODE_ENV=production
